diff --git a/node_modules/@react-native-community/cli-platform-apple/build/commands/runCommand/runOnSimulator.js b/node_modules/@react-native-community/cli-platform-apple/build/commands/runCommand/runOnSimulator.js
--- a/node_modules/@react-native-community/cli-platform-apple/build/commands/runCommand/runOnSimulator.js
+++ b/node_modules/@react-native-community/cli-platform-apple/build/commands/runCommand/runOnSimulator.js
@@ -42,7 +42,22 @@ async function runOnSimulator(xcodeProject, platform, mode, scheme, args, simula
   const activeDeveloperDir = _child_process().default.execFileSync('xcode-select', ['-p'], {
     encoding: 'utf8'
   }).trim();
-  _child_process().default.execFileSync('open', [`${activeDeveloperDir}/Applications/Simulator.app`, '--args', '-CurrentDeviceUDID', simulator.udid]);
+  // Xcode 27 no longer ships Simulator.app inside the Xcode bundle; the
+  // simulator UI is hosted by DeviceHub.app instead. Fall back to it, and never
+  // let failing to raise a window abort the build.
+  const nodeFs = require('fs');
+  const nodePath = require('path');
+  const simulatorApp = `${activeDeveloperDir}/Applications/Simulator.app`;
+  const deviceHubApp = nodePath.join(activeDeveloperDir, '..', 'Applications', 'DeviceHub.app');
+  try {
+    if (nodeFs.existsSync(simulatorApp)) {
+      _child_process().default.execFileSync('open', [simulatorApp, '--args', '-CurrentDeviceUDID', simulator.udid]);
