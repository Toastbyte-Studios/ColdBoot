<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Cold Boot</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSMotionUsageDescription</key>
	<string>We use the barometer sensor to read atmospheric pressure for weather and altitude awareness.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location to show the last GPS fix on the Device Status screen.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>TOAST needs background location access to continue recording your GPS trail when the screen is locked or the app is backgrounded.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>This app uses the camera to take photos for your notes and for the flashlight.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to your photo library to attach photos to your notes.</string>
	<key>NSContactsUsageDescription</key>
	<string>TOAST uses your contacts to let you quickly add emergency contacts to your emergency plan.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>We need microphone access to record voice logs for emergency documentation.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>BootSplash</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIAppFonts</key>
	<array>
		<string>Ionicons.ttf</string>
		<string>Bitter-Regular.ttf</string>
		<string>Bitter-Bold.ttf</string>
	</array>
</dict>
</plist>
