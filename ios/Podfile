# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
load "#{__dir__}/../node_modules/@maplibre/maplibre-react-native/MapLibreReactNative.podspec"

platform :ios, min_ios_version_supported
project 'ColdBoot.xcodeproj'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'ColdBoot' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
    $MLRN.post_install(installer)
    # Xcode 26+ rejects deployment targets below iOS 15. A few pods (and the
    # resource bundle targets CocoaPods generates for them) still declare much
    # older minimums, so pin every pod target to the version RN supports.
    projects = [installer.pods_project] + installer.generated_projects
    projects.uniq.each do |project|
      project.targets.each do |target|
        target.build_configurations.each do |build_config|
          build_config.build_settings['ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
          deployment_target = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
          if deployment_target.nil? || Gem::Version.new(deployment_target) < Gem::Version.new(min_ios_version_supported)
            build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
          end
        end
      end
      project.save
    end
  end
end
